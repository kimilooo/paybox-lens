{
  "name": "paybox-lens",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "start": "node scripts/build.mjs && node scripts/local-server.mjs",
    "start:ephemeral": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate-artifact.mjs",
    "security": "node scripts/security-check.mjs && npm audit --audit-level=low",
    "release:prepare": "node scripts/prepare-public.mjs",
    "release:pack": "node scripts/build.mjs && node scripts/prepare-public.mjs && python scripts/package-release.py"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "linkedom": "^0.18.14"
  }
}
